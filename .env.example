# Web application database. On Vercel this must be reachable from Vercel,
# normally MongoDB Atlas. Never expose this with a NEXT_PUBLIC_ prefix.
MONGODB_URI=mongodb://username:password@host:27017/clutch_atlas?authSource=admin

# Scraper database on this server. Omit to use MONGODB_URI for both.
SCRAPE_MONGODB_URI=mongodb://username:password@127.0.0.1:27017/clutch_atlas?authSource=admin

CLUTCH_MCP_URL=https://bot.clutch.co/mcp
CLUTCH_SERVICE=Advertising
SCRAPER_BATCH_SIZE=500
SCRAPER_DELAY_MS=1000
DOMAIN_CONCURRENCY=4
DOMAIN_BATCH_DELAY_MS=500
DOMAIN_REQUEST_TIMEOUT_MS=15000
